# Copy this file to .env and fill in values. Never commit .env.
# Everything is optional for local development: without values the server uses
# an in-memory database, local file storage and insecure dev secrets.

PORT=4000

# --- Secrets (REQUIRED when NODE_ENV=production) ---
# Generate each one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=
KYC_TOKEN_SECRET=
MOCK_SNAPKYC_KEY=
DEMO_PASSWORD=demo123
KYC_TOKEN_TTL_DAYS=30

# --- Database (Supabase: Project Settings > Database > Connection string > URI) ---
DATABASE_URL=

# --- File storage (Supabase: Project Settings > API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=kyc-media

# --- TURN relay (Metered dashboard). Use EITHER the API key pair OR static credentials ---
METERED_DOMAIN=
METERED_API_KEY=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Only if the frontend is hosted on a different domain (e.g. Vercel) ---
CLIENT_ORIGIN=

# --- For testers outside India only ---
ALLOW_OUTSIDE_INDIA=false
